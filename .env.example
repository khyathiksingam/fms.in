# ==============================================================================
# Faculty File Management System (FFMS) - Environment Template
# ==============================================================================
# Copy this file to .env and fill in your actual production credentials.
# NEVER commit .env or any file containing real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Managed PostgreSQL)
# ------------------------------------------------------------------------------
# Full connection URL format:
# postgresql://<username>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=postgresql://postgres_user:your_secure_db_password@postgres-host.example.com:5432/ffms_production?sslmode=require

# Individual credentials (optional alternative if not using a single connection URL):
DATABASE_USERNAME=postgres_user
DATABASE_PASSWORD=your_secure_db_password

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Security
# ------------------------------------------------------------------------------
# Cryptographically random string with at least 32 characters (256 bits)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_min_256_bits!

# JWT expiration duration in hours (e.g., 168 = 7 days)
JWT_EXPIRATION_HOURS=168

# ------------------------------------------------------------------------------
# 3. Network & CORS Configuration
# ------------------------------------------------------------------------------
# HTTP port for the Node.js Express backend
PORT=5000

# Comma-separated list of allowed frontend origins (without trailing slashes)
CORS_ALLOWED_ORIGINS=https://ffms.college.edu,https://app.college.edu,http://localhost:5173

# ------------------------------------------------------------------------------
# 4. Durable File & Logo Storage Configuration
# ------------------------------------------------------------------------------
# Supported providers: "local" (persistent disk mount) or "s3" / "r2" / "azure"
STORAGE_PROVIDER=local

# Local storage directories (when STORAGE_PROVIDER=local)
STORAGE_LOCAL_DIR=/var/data
STORAGE_UPLOAD_DIR=/var/data/uploads
STORAGE_LOGO_DIR=/var/data/logos

# Cloud object storage settings (when STORAGE_PROVIDER=s3 / r2 / minio)
STORAGE_BUCKET=ffms-production-assets
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=us-east-1

# ------------------------------------------------------------------------------
# 5. Email Notification Configuration (Verification OTPs & Alerts)
# ------------------------------------------------------------------------------
# API key for the transactional email provider (SendGrid, Resend, Mailgun, AWS SES)
EMAIL_PROVIDER_API_KEY=your_transactional_email_provider_api_key

# Outgoing sender address and display name
EMAIL_FROM=noreply@college.edu
EMAIL_FROM_NAME=Faculty File Management System

# ------------------------------------------------------------------------------
# 6. Initial Administrative Provisioning (First Boot Only)
# ------------------------------------------------------------------------------
# Seed passwords for first-time account setup. Existing accounts will NEVER be overwritten.
ADMIN_PASSWORD=InitialAdminPassword#2026
FFMS_HOD_TEMP_PASSWORD=InitialHodPassword#2026

# ------------------------------------------------------------------------------
# 7. Frontend Environment Configuration (Vercel / Vite)
# ------------------------------------------------------------------------------
# Backend API base URL consumed by Vite React frontend
VITE_API_BASE_URL=https://ffms-backend.onrender.com
